# Copy this file to .env for local docker compose usage, or copy values into Portainer stack env vars.
# Replace example secrets before deploying publicly.

# Common
TZ=UTC
PUID=1000
PGID=1000

# Image tags (pin versions instead of latest if desired)
PORTAINER_TAG=latest
SONARR_TAG=latest
RADARR_TAG=latest
JELLYFIN_TAG=latest
AUDIOBOOKSHELF_TAG=latest
HOMARR_TAG=latest
UPTIME_KUMA_TAG=latest
METABASE_TAG=latest
MONICA_TAG=latest
MONICA_DB_TAG=11.4
VAULTWARDEN_TAG=latest

# Media and downloads host paths
DOWNLOADS_PATH=/srv/downloads
SONARR_TV_PATH=/srv/media/tv
RADARR_MOVIES_PATH=/srv/media/movies
JELLYFIN_MEDIA_PATH=/srv/media
AUDIOBOOKS_PATH=/srv/media/audiobooks
PODCASTS_PATH=/srv/media/podcasts

# Monica (required to change for production)
MONICA_APP_URL=http://localhost:6875
MONICA_APP_KEY=base64:REPLACE_WITH_REAL_APP_KEY
MONICA_DB_DATABASE=monica
MONICA_DB_USER=monica
MONICA_DB_PASSWORD=change_me_monica_password
MONICA_DB_ROOT_PASSWORD=change_me_root_password
