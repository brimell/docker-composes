# Copy this file to .env for local docker compose usage, or copy values into
# Portainer stack env vars.

# Shared media paths (used by Sonarr, Radarr, Jellyfin, Audiobookshelf)
MEDIA_LOCAL_PATH=/Users/bill/Documents/media_local
MEDIA_EXTERNAL_PATH=/Volumes/Stuff/media

# Monica secrets (change for production)
MONICA_APP_KEY=base64:REPLACE_WITH_REAL_APP_KEY
MONICA_DB_PASSWORD=change_me_monica_password
MONICA_DB_ROOT_PASSWORD=change_me_root_password
