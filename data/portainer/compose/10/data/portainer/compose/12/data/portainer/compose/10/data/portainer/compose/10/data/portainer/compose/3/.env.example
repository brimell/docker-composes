# Copy this file to .env for local docker compose usage, or copy values into
# Portainer stack env vars.

# Host path where container config/data folders are stored.
CONFIG_ROOT=/Users/bill/Documents/GitHub/docker-composes/data

# Media paths mounted into media apps.
MEDIA_MOVIES_PATH=/Volumes/Stuff/media/movies
MEDIA_SHOWS_PATH=/Volumes/Stuff/media/shows
MEDIA_AUDIOBOOKS_PATH=/Volumes/Stuff/media/audiobooks
MEDIA_PHOTOS_PATH=/Volumes/Stuff/media/photos
MEDIA_LOCAL_MOVIES_PATH=/Users/bill/Documents/media_local/movies
MEDIA_LOCAL_SHOWS_PATH=/Users/bill/Documents/media_local/shows
MEDIA_LOCAL_AUDIOBOOKS_PATH=/Users/bill/Documents/media_local/audiobooks
MEDIA_LOCAL_PHOTOS_PATH=/Users/bill/Documents/media_local/photos

# Monica secrets (change for production)
MONICA_APP_KEY=base64:REPLACE_WITH_REAL_APP_KEY
MONICA_DB_PASSWORD=change_me_monica_password
MONICA_DB_ROOT_PASSWORD=change_me_root_password

# PhotoPrism admin login (change for production)
PHOTOPRISM_ADMIN_PASSWORD=change_me_photoprism_password
